# GitHub Pages base 路径
# 项目页（仓库名为 yourname-portfolio）填 /yourname-portfolio/
# 用户/组织主页或自定义域名填 /
VITE_BASE_URL=/yourname-portfolio/

# GitHub 仓库，格式：用户名/仓库名
VITE_GITHUB_REPO=yourname/yourname-portfolio

# 默认分支
VITE_GITHUB_BRANCH=main

# 站点完整 URL
VITE_SITE_URL=https://yourname.github.io/yourname-portfolio
